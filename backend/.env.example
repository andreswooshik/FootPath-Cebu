# FootPath-Cebu backend environment template.
# Copy to `.env` and fill in real values. The real `.env` is gitignored;
# this template (placeholders only) is tracked so teammates know what to set.

# --- Django core ---
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
# Set to 1 for local development only. Never 1 in production.
DJANGO_DEBUG=1
# Comma-separated hosts, used only when DEBUG is off (production).
# DJANGO_ALLOWED_HOSTS=api.example.com
# Comma-separated allowed CORS origins, used only when DEBUG is off.
# CORS_ORIGINS=https://app.example.com
# Shared cache for production rate limiting and token revocation.
# REDIS_URL=redis://127.0.0.1:6379/0
# Optional centralized exception monitoring. PII capture stays disabled.
# SENTRY_DSN=https://public-key@your-sentry-host/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# RELEASE_SHA=git-commit-sha
# DJANGO_LOG_LEVEL=INFO
# Production Compose publishes Gunicorn on loopback for a host TLS proxy.
# WEB_BIND_ADDRESS=127.0.0.1
# WEB_PORT=8000

# --- Database ---
# Leave the DB_* vars UNSET to use local SQLite (zero setup; used by the test
# suite regardless). SET them to point Django at a Postgres such as Supabase.
# Supabase IS Postgres — only this connection block changes.
#
# From Supabase: Project Settings > Database > Connection info / pooler.
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=your-db-password
# Port 5432 = direct/session pooler; 6543 = transaction pooler (server-side
# cursors auto-disabled for 6543, see config/settings.py).
# DB_PORT=5432
# Hosted PostgreSQL normally requires `require`; local Docker PostgreSQL uses
# `disable` because TLS terminates outside the private container network.
# DB_SSLMODE=require

# --- Firebase Admin SDK (identity + FCM push) ---
# Path (relative to backend/) to the service-account JSON. Kept out of git.
# Download: Firebase Console > Project settings > Service accounts.
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json

# --- Supabase Storage (player photos) ---
# Only a server-side Secret/service_role key; never ship it in the Flutter app.
# From Supabase: Project Settings > API.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Prefer a current Secret key; legacy service_role JWT keys remain supported.
# SUPABASE_SERVICE_KEY=sb_secret_your-server-key
# Storage bucket name for player photos (create it as a PRIVATE bucket).
# SUPABASE_PHOTO_BUCKET=player-photos
# Private bucket for club coach-license applications (JPG, PNG, PDF).
# SUPABASE_LICENSE_BUCKET=coach-licenses
