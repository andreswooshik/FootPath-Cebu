<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy (audit finding S2).

  Cleartext (http://) is DENIED by default, so a release build pointed at the
  production HTTPS API (via dart-define=API_BASE_URL=https://...) can never be
  silently downgraded to plaintext or MITM'd.

  The only exception is the local development hosts: the Android emulator's
  host loopback (10.0.2.2) and localhost, which the debug build talks to over
  http (see lib/core/config/api_config.dart). Those hosts are unreachable in
  production, so allowing cleartext to them costs nothing in a shipped app.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
