# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
backend/staticfiles/
backend/backups/
__pycache__/
*.py[cod]
*.dump
# pubspec.lock is committed: this is an application, so builds stay reproducible

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*
# ...but keep the committed template (placeholders only, no real secrets) tracked
# so teammates know which vars to set. The real .env stays ignored above.
!.env.example

# Secrets — never commit server credentials or private keys (repo-wide,
# belt-and-suspenders on top of backend/.gitignore). Note: Firebase CLIENT
# config (google-services.json) is intentionally NOT ignored — it is bundled
# into the app and is not a secret.
**/secrets/
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
*.pem
*.key
*.p12
*.keystore

# Avoid committing generated Javascript files (dart2js output lives under
# build/, already ignored above; this repo also has hand-written JS under
# backend/console/static/, so no blanket *.js rule here):
*.dart.js
# Produced by the --dump-info flag.
*.info.json

.flutter-plugins
.flutter-plugins-dependencies
.kotlin/

# Personal study notes for the skill test — not part of the project deliverable.
study-notes/

# Local/generated working artifacts. Published documentation artifacts belong
# under docs/; these paths should remain disposable.
/tmp/
/.tmp/
/output/
/outputs/
/.git-commit-msg.txt

# Local manuscript and workflow-document working files.
/FootPath_Cebu_Manuscript.docx
/FootPath_Required_Chapters_1_to_3.docx
/FootPath_revised.docx
/revise_footpath_paper.py
/manuscript_assets/
/manuscript_render/
/manuscript_render_final/
/required_render/
/_workflow_demo_render_*/
/docs/capstone-defense/FootPath_Cebu_Workflow_Demonstration_Guide.docx

# Local review and recovery notes.
/docs/FRONTEND-CODE-AUDIT-2026-09-10.md
/docs/OFFLINE-ATTENDANCE-RECOVERY.md
